<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <!-- GitHub Pages no permite cabeceras HTTP propias: la política de seguridad va aquí -->
  <meta http-equiv="Content-Security-Policy" content="<%= csp %>">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <title><%= titulo %></title>
  <meta name="description" content="<%= descripcion %>">
  <meta property="og:title" content="<%= titulo %>">
  <meta property="og:description" content="<%= descripcion %>">
  <meta property="og:image" content="<%= site.urlBase %>/img/<%= typeof ogImagen !== 'undefined' ? ogImagen : 'mari-hero-naranja.jpg' %>">
  <meta name="theme-color" content="#1B2545">
  <% if (noindex) { %><meta name="robots" content="noindex, nofollow"><% } %>
  <link rel="icon" href="<%= ruta('/img/favicon.svg') %>" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:wght@300;400;500;600;700&display=swap">
  <link rel="stylesheet" href="<%= ruta('/css/styles.css') %>">
  <script src="<%= ruta('/js/main.js') %>" defer></script>
</head>
<body>
